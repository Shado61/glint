# Glint — переменные окружения (в Render: Environment). Файл .env не загружайте на GitHub.
BASE_URL=https://ваш-адрес.onrender.com
# база данных Postgres (Neon). Без неё данные хранятся в файле и пропадают при перезапуске на Render
DATABASE_URL=
# TURN-сервер для звонков между сетями, где прямое соединение невозможно (мобильный интернет, офисы).
# Например, бесплатный тариф Metered или ExpressTURN. Можно перечислить несколько адресов через запятую.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# ИИ: бесплатные ключи — ответы быстрее и без отказов. Без них работают бесплатные сервисы без ключа (могут быть заняты)
# Google Gemini: aistudio.google.com → Get API key
GEMINI_API_KEY=
# Groq (очень быстрый): console.groq.com/keys
GROQ_API_KEY=
# необязательно: LLM7 (token.llm7.io) и Pollinations (enter.pollinations.ai) — больше лимит
LLM7_TOKEN=
POLLINATIONS_KEY=
