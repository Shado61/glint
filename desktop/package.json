{
  "name": "manasenger-desktop",
  "productName": "Manasenger",
  "version": "1.0.0",
  "description": "Manasenger — сообщения, звонки, видеозвонки",
  "main": "main.js",
  "author": "Manasenger",
  "license": "UNLICENSED",
  "private": true,
  "scripts": { "dist": "electron-builder --publish never" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.manasenger.app",
    "productName": "Manasenger",
    "files": ["main.js", "icon.png", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": ["nsis"], "icon": "build/icon.png", "artifactName": "Manasenger-Setup.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "shortcutName": "Manasenger", "runAfterFinish": true },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.social-networking", "artifactName": "Manasenger-mac.${ext}" },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Network", "artifactName": "Manasenger-linux.${ext}" }
  }
}
